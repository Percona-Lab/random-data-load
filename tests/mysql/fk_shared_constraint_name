CREATE TABLE t1(
	id int auto_increment primary key,
	data varchar(30)
);
CREATE TABLE t2(
	id int auto_increment primary key,
	t1_id int not null,
	data varchar(30),
	CONSTRAINT fk_t2_t1 FOREIGN KEY(t1_id) REFERENCES t1(id)
);

-- a constraint name is unique within a schema, not within the server: a second
-- copy of the same tables gives every one of them a namesake. This copy is
-- left empty on purpose, so sampling the wrong one cannot go unnoticed.
CREATE DATABASE test_dup;
CREATE TABLE test_dup.t1(
	id int auto_increment primary key,
	data varchar(30)
);
CREATE TABLE test_dup.t2(
	id int auto_increment primary key,
	t1_id int not null,
	data varchar(30),
	CONSTRAINT fk_t2_t1 FOREIGN KEY(t1_id) REFERENCES test_dup.t1(id)
);
