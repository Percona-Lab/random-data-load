CREATE TABLE t1(
	id int auto_increment primary key,
	data varchar(30)
);
-- the schema already points t2 at t1, on another column: a join written the
-- other way round has to be read as a key on t2 too, not on t1
CREATE TABLE t2(
	id int auto_increment primary key,
	t1_id int,
	other_t1_id int,
	FOREIGN KEY(other_t1_id) REFERENCES t1(id)
);
