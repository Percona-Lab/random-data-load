CREATE TABLE t1(
	id uuid,
	amount numeric(14,4),
	flag boolean,
	created_at timestamptz,
	data varchar(30),
	primary key (id, amount, flag, created_at)
);
CREATE TABLE t2(
	id bigint generated always as identity primary key,
	t1_id uuid not null,
	t1_amount numeric(14,4) not null,
	t1_flag boolean not null,
	t1_created_at timestamptz not null,
	foreign key (t1_id, t1_amount, t1_flag, t1_created_at) references t1(id, amount, flag, created_at)
);
